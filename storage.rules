rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function item(contentId) {
      return firestore.get(/databases/(default)/documents/ieltsContent/$(contentId)).data;
    }
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function canEdit(contentId) {
      return item(contentId).ownerUid == request.auth.uid
          || (profile().role == 'teacher' && item(contentId).teacherUid == request.auth.uid);
    }
    match /ieltsAudio/{ownerUid}/{contentId}/{fileName} {
      allow read: if request.auth != null
                  && ((item(contentId).status == 'published' && item(contentId).archived == false) || canEdit(contentId));
      allow create, update: if request.auth != null && request.auth.uid == ownerUid && canEdit(contentId)
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('audio/(mpeg|mp4|wav|x-wav|webm|ogg|aac|flac)');
      allow delete: if false;
    }
  }
}
